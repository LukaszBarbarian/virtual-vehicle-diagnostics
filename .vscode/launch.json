{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🖥️ UI",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/runtimes/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "STORAGE_MODE": "local"
      }
    },
    {
      "name": "🚂 PIPELINES (Bronze → Gold)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/runtimes/run_pipelines.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "STORAGE_MODE": "local"
      }
    },
    {
      "name": "🧠 ML DATASETS (Gold → Train/Test)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/app/runtimes/run_ml_datasets.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "STORAGE_MODE": "local"
      }
    }
  ]
}
