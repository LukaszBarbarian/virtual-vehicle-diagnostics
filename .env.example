# Copy to .env and adjust. Every value is optional; defaults run everything locally.

# Kafka broker (docker compose in infra/kafka exposes localhost:9092)
KAFKA_BROKERS=localhost:9092

# Data lake: "local" (default, writes to ./data/lake) or "azure" (ADLS Gen2 over abfss://)
STORAGE_MODE=local
# LOCAL_LAKE_DIR=./data/lake
# AZURE_STORAGE_ACCOUNT=yourstorageaccount
# AZURE_STORAGE_KEY=your-shared-key

# Spark
# SPARK_MASTER=local[*]
# Optional directory of pre-downloaded jars (otherwise Kafka/Azure connectors are pulled from Maven)
# SPARK_JARS_DIR=C:/spark/jars

# MLflow (defaults to ./mlflow.db and the latest registered driving_style_classifier)
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MODEL_URI=models:/driving_style_classifier/latest
